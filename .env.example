# =============================================================================
# IARS - Environment Template (copy to .env and fill secrets)
# SECURITY: Never commit .env to git. Generate secrets with `openssl rand -hex 32`
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# --- Database: Choose ONE ---
# PostgreSQL (recommended for production)
DATABASE_URL="postgresql://iars_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/iars_db?schema=public"
# MongoDB (alternative - change provider in prisma/schema.prisma to mongodb)
# DATABASE_URL="mongodb://localhost:27017/iars_db"

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_32_BYTES_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_32_BYTES_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Security ---
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_32_HEX
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
HELMET_CSP_ENABLED=true

# --- Optional ---
# For audit logs / email etc
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# --- Frontend (Vite uses VITE_ prefix) ---
# VITE_API_URL=http://localhost:4000/api/v1
